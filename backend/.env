# Database connection string format:
# postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/clinical_trials

# API Key for your LLM (e.g., Groq)
LLM_API_KEY=gsk_your_api_key_here

# Optional overrides (since they have defaults in config.py)
ENVIRONMENT=development